{
  "name": "graphql-content-mapper",
  "version": "1.0.0",
  "description": "Zero-codegen GraphQL TypedDocumentNode and enum loader for TypeScript 7.1 Content Mappers, Vite, and Next.js",
  "author": "SoraKumo",
  "license": "MIT",
  "homepage": "https://github.com/SoraKumo001/graphql-content-mapper#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/SoraKumo001/graphql-content-mapper.git",
    "directory": "packages/graphql-content-mapper"
  },
  "bugs": {
    "url": "https://github.com/SoraKumo001/graphql-content-mapper/issues"
  },
  "keywords": [
    "graphql",
    "typescript",
    "content-mapper",
    "typed-document-node",
    "vite",
    "nextjs",
    "turbopack",
    "webpack",
    "zero-codegen"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./loader": {
      "types": "./dist/loader.d.ts",
      "default": "./dist/loader.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./compiler": {
      "types": "./dist/compiler.d.ts",
      "default": "./dist/compiler.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "graphql": "^16.0.0 || ^17.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "graphql": "^17.0.2",
    "typescript": "^7.1.0-beta",
    "vitest": "^4.1.0"
  },
  "typescript": {
    "contentMapper": {
      "exec": [
        "node",
        "dist/index.js"
      ],
      "outputExtensions": {
        ".graphql": ".js",
        ".gql": ".js"
      }
    }
  }
}
